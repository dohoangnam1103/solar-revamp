# Database (Postgres runs inside Docker on the MiniPC)
POSTGRES_DB="soliq"
POSTGRES_USER="soliq"
POSTGRES_PASSWORD="change-this-password"
APP_DATABASE_URL="postgresql://soliq:change-this-password@db:5432/soliq"

# App
NEXT_PUBLIC_SITE_URL="https://soliq.solarcheck.best"
NEXT_PUBLIC_SITE_NAME="SOLIQ ENERGY"
APP_ADMIN_SESSION_SECRET="change-this-random-session-secret"
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=""

# Image name override (defaults to soliq-web:latest)
WEB_IMAGE="soliq-web:latest"
