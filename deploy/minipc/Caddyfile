{
  email admin@soliq.com.vn
}

# Production domain (apex + www) — Caddy auto-provisions Let's Encrypt SSL.
# www → redirect to apex.
soliq.com.vn, www.soliq.com.vn {
  encode zstd gzip
  reverse_proxy web:3000
  @www host www.soliq.com.vn
  redir @www https://soliq.com.vn{uri} permanent
}

# Plain HTTP catch-all → 308 redirect to HTTPS
:80 {
  redir https://{host}{uri} 308
}
