# Copy to .env.vps and fill in real values. .env.vps is gitignored.

# Database (Postgres runs inside Docker on the VPS)
POSTGRES_DB="soliq"
POSTGRES_USER="soliq"
POSTGRES_PASSWORD="change-this-password"
APP_DATABASE_URL="postgresql://soliq:change-this-password@db:5432/soliq"

# App
NEXT_PUBLIC_SITE_URL="https://soliq2.solarcheck.best"
NEXT_PUBLIC_SITE_NAME="SOLIQ ENERGY"
APP_ADMIN_SESSION_SECRET="change-this-random-session-secret"
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=""

# SMTP for email notifications (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Image name override (defaults to soliq-web:latest)
WEB_IMAGE="soliq-web:latest"
